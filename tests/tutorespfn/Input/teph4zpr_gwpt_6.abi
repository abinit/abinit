# GW computation at Gamma for MgO.
 ecut 35.0

 ngkpt 4 4 4
 nshiftk 1
 shiftk 0 0 0

##############################################
####                 SECTION: SIGMA
##############################################
 optdriver 4                               # Enter SIGMA driver
 getwfk_filepath "teph4zpr_gwpt_4o_WFK"    # 4x4x4 k-mesh
 getscr_filepath "teph4zpr_gwpt_5o_SCR"
 nband 50
 ecuteps 8
 ecutsigx 35.0

##############################################
####                 SECTION: Sigma_nk
##############################################
 #nkptgw 1
 #kptgw
 #   0.0    0.0    0.0
 #bdgw
 #   8 9

 gw_qprange -4

 zcut 0.01 eV

 structure = "abifile:MgO_eph_zpr/flow_zpr_mgo/w0/t0/outdata/out_DEN.nc"

 pp_dirpath = "$ABI_PSPDIR"
 pseudos = "O.psp8, Mg-sp-gw.psp8"

##############################################################
