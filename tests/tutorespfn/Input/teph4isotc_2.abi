# MgB2: generate coarse-mesh wavefunctions and an ab-initio band structure.

ndtset 2

iscf -2
tolwfr 1.0d-12
getden_filepath "MgB2_eph4isotc/flow_mgb2_phonons/w0/t0/outdata/out_DEN.nc"
structure "abifile:MgB2_eph4isotc/flow_mgb2_phonons/w0/t0/outdata/out_DEN.nc"

# Dataset 1: complete uniform mesh required by Wannier90.
kptopt1 1
ngkpt1 6 6 4
nshiftk1 1
shiftk1 0.0 0.0 0.0
prtebands1 0
prtpot1 1

# Dataset 2: ab-initio bands along Gamma-K-M-Gamma-A-H-L-A.
kptopt2 -7
ndivsm2 4
kptbounds2
  0.0 0.0 0.0       # Gamma
  1/3 1/3 0.0       # K
  0.5 0.0 0.0       # M
  0.0 0.0 0.0       # Gamma
  0.0 0.0 0.5       # A
  1/3 1/3 0.5       # H
  0.5 0.0 0.5       # L
  0.0 0.0 0.5       # A
prtebands2 1
prtwf2 0

ecut 38.0
nband 16
occopt 4
tsmear 0.02

pp_dirpath "$ABI_PSPDIR/Psdj_nc_sr_04_pw_std_psp8/"
pseudos "Mg-low.psp8, B.psp8"

