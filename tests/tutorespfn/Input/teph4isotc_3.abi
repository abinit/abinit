# MgB2: Wannierize the coarse-mesh wavefunctions and write ABIWAN.nc.

optdriver 8
wfk_task "wannier"
getwfk_filepath "teph4isotc_2o_DS1_WFK"

prtwant 2
w90iniprj 2

structure "abifile:MgB2_eph4isotc/flow_mgb2_phonons/w0/t0/outdata/out_DEN.nc"

#kptopt 1
ngkpt 6 6 4
nshiftk 1
shiftk 0.0 0.0 0.0

ecut 38.0
nband 16
occopt 4
tsmear 0.02

pp_dirpath "$ABI_PSPDIR/Psdj_nc_sr_04_pw_std_psp8/"
pseudos "Mg-low.psp8, B.psp8"

