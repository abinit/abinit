! Postprocessing to switch between constrained/unconstrained magnetic functionals
! and numerical frequency interpolation for antiferromagnetic MnF2
! (M. Royo, 12.12.2025)

   prtvol 11
!Magnetic penalty
   magpen 0.0125
   mpatpol 1 2
   mpdir 1 1 0
   mpopt 2  !(1 Frozen-spin, 2 Relaxed-spin)
   timdisp 0
   asr 0
   chneut 0

!Frequency interpolation
   freqflag 3
   nfreq  10
   frmin  0.000
   frmax  0.01
   eta 0.000001

