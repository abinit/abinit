# Berry curvatures calculation in antiferromagnetic MnF2 (omega=0 and q=0).
# (M. Royo, 12.12.2025)

   ndtset 2
   jdtset 7 8 

outdata_prefix = "tcdfpt_2o"

## GENERAL PARAMETERS
    nqpt   1
     qpt   0.0 0.0 0.0   
  getwfk   1            
  get1wf   3

optdriver  10
  timdisp  1
  tim1rev  1
### 7) ADIABATIC DYNAMICS WITH MACROSCOPIC ZEEMAN
  
  d3e_pert1_magn7  1
d3e_pert1_magdir7  1 1 1
  d3e_pert1_elfd7  1
   d3e_pert1_dir7  1 1 1
  d3e_pert1_phon7  1
 d3e_pert1_atpol7  1 6

  d3e_pert2_magn7  1
d3e_pert2_magdir7  1 1 1
  d3e_pert2_elfd7  1
   d3e_pert2_dir7  1 1 1
  d3e_pert2_phon7  1
 d3e_pert2_atpol7  1 6

### 8) ADIABATIC DYNAMICS WITH LOCAL ZEEMAN
  
  d3e_pert1_magn8  2
 d3e_pert1_magat8  1 2
d3e_pert1_magdir8  1 1 0
  d3e_pert1_elfd8  1
   d3e_pert1_dir8  1 1 1
  d3e_pert1_phon8  1
 d3e_pert1_atpol8  1 6

  d3e_pert2_magn8  2
 d3e_pert2_magat8  1 2
d3e_pert2_magdir8  1 1 0
  d3e_pert2_elfd8  1
   d3e_pert2_dir8  1 1 1
  d3e_pert2_phon8  1
 d3e_pert2_atpol8  1 6

### MORE GENERAL PARAMETERS

# xc functional
ixc  7 

#Definition of the atom types
ntypat 2          
znucl 25 9
                
#Definition of the atoms
natom 6           
typat 2*1 4*2     

#Definition of the unit cell
acell     9.2100000000E+00  9.2100000000E+00  6.2560000000E+00 Bohr
rprim     1.0000 0.0000 0.0000
          0.0000 1.0000 0.0000
          0.0000 0.0000 1.0000
xred     -9.8060630002E-22  3.3877150941E-20  0.0000000000E+00
          5.0000000000E-01  5.0000000000E-01  5.0000000000E-01
          6.9578890653E-01  6.9578890653E-01  7.4518417881E-31
          1.9578890653E-01  8.0421109347E-01  5.0000000000E-01
          3.0421109347E-01  3.0421109347E-01  0.0000000000E+00
          8.0421109347E-01  1.9578890653E-01  5.0000000000E-01


#Definition of the planewave basis set
ecut   4.0         # Maximal kinetic energy cut-off, in Hartree
nband  58

#Definition of the k-point grid
kptopt 3          # Option for the automatic generation of k points, taking
                  # into account the symmetry
ngkpt 2 2 3      

nshiftk 1         
shiftk 0.5 0.5 0.5

#Symmetries deactivated for magnetic systems
nsym 1

nspden   4   
nspinor  2   

#Pseudos
pp_dirpath "$ABI_PSPDIR"
pseudos "Mn_LDA_FR.psp8, F_LDA_FR.psp8"

