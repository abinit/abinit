# MgB2: compute alpha2F from Wannier-interpolated matrix elements.

optdriver 7
eph_task -12

getddb_filepath "MgB2_eph4isotc/flow_mgb2_phonons/w1/outdata/out_DDB"
getwfk_filepath "teph4isotc_2o_DS1_WFK"
getdvdb_filepath "teph4isotc_1_DVDB"
getabiwan_filepath "teph4isotc_3o_ABIWAN.nc"
getgwan_filepath "teph4isotc_4o_GWAN.nc"
structure "abifile:MgB2_eph4isotc/flow_mgb2_phonons/w0/t0/outdata/out_DEN.nc"

ddb_ngqpt 4 4 4
eph_ngkpt_fine 8 8 8
eph_ngqpt_fine 8 8 8
eph_nshiftk_fine 1
eph_shiftk_fine 0.0 0.0 0.0
dipdip 0

gstore_kzone "bz"
gstore_qzone "ibz"

eph_intmeth 1
eph_fsmear 0.1 eV
ph_smear 0.5 meV
ph_wstep 0.1 meV

ph_ndivsm 2
ph_nqpath 3
ph_qpath
  0.0 0.0 0.0
  0.5 0.0 0.0
  1/3 1/3 0.0

ngkpt 6 6 4
nshiftk 1
shiftk 0.0 0.0 0.0

prtphbands 0
prtphdos 0

ecut 38.0
nband 16
occopt 4
tsmear 0.02

pp_dirpath "$ABI_PSPDIR/Psdj_nc_sr_04_pw_std_psp8/"
pseudos "Mg-low.psp8, B.psp8"

