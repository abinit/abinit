# MgB2: generate a symmetry-reduced GSTORE and Wannierize the e-ph vertex.

optdriver 7
eph_task 11

getddb_filepath "MgB2_eph4isotc/flow_mgb2_phonons/w1/outdata/out_DDB"
getwfk_filepath "teph4isotc_2o_DS1_WFK"
getdvdb_filepath "teph4isotc_1_DVDB"
getabiwan_filepath "teph4isotc_3o_ABIWAN.nc"
structure "abifile:MgB2_eph4isotc/flow_mgb2_phonons/w0/t0/outdata/out_DEN.nc"

ddb_ngqpt 4 4 4
eph_ngqpt_fine 6 6 4
dipdip 0

# Compute only symmetry-inequivalent (k,q) pairs and reconstruct the full BZ.
gstore_kzone "bz"
gstore_qzone "bz"
gstore_kfilter "none"
gstore_sym 2
gstore_use_lgk 1
gstore_with_vk 0
eph_restart 0

gstore_convert "epiq"  # Produce the files required by the EPIQ code.
                       # IMPORTANT:
                       # This generates many files; enable it only if you plan to use EPIQ.

mixprec 1
boxcutmin 1.1

ngkpt 6 6 4
nshiftk 1
shiftk 0.0 0.0 0.0

prtphbands 0
prtphdos 0

ecut 38.0
nband 16
occopt 4
tsmear 0.02

pp_dirpath "$ABI_PSPDIR/Psdj_nc_sr_04_pw_std_psp8/"
pseudos "Mg-low.psp8, B.psp8"

