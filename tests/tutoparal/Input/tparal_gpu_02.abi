# ===================================================== #
# ABINIT - INPUT FILE - TITANIUM 128 ATOMS              #
# ===================================================== #

#Keywords related to parallelism
npband     4
gpu_option "GPU_OPENMP"

wfoptalg 111   # ChebFi

nband 1024

# --------------------------------------------------------

#Self-consistent cycle parameters
tolvrs 1.d-5
nstep 5

#Plane wave basis
ecut 5.
pawecutdg 10.

#K-points and symetries
ngkpt 2 2 1
istwfk *1
nsym 0
chksymbreak 0

#Electronic configuration
occopt 3
tsmear 1800. K

#Activation/deactivation of I/O
optforces 2
optstress 1
prtwf 0
prtden 0
prteig 0
prtddb 0
timopt 0
prtgsr 0

#Simulation cell
acell 25.2 25.2 25.2
rprim 1. 0. 0. 0. 1. 0. 0. 0. 1.
natom 128
ntypat 1
typat 128*1
znucl 22.
chkprim 0
pawovlp -1
pp_dirpath "$ABI_PSPDIR"
pseudos "ti.hpc.paw"

