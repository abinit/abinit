#Testing DMFT Complex G_tau

#Multi_dataset parameters
 ndtset 2      # Two datasets
 jdtset 1 2    # one followed by two
 getden2 1     # Second one takes the density of first
 getwfk2 1     # Second one takes the wavefunction of first

 pawprtvol 3  # Printing additional information
 prtvol 4     #
 prtden -1    #

############################
# Structural Parameters
############################

#Definition of unit cell
 acell  3.62  3.62  5.99 Angstrom  # lattice parameter
 rprim  1.0   0.0   0.0            # Primitive cell
       -0.5   0.8660254038  0.0
        0.0   0.0   1.0

 chksymbreak 0

#Definition atom
 ntypat 1   # number of different types of atoms
 znucl 58   # z number of atom

#Definition of the atoms
 natom 2           # number of atom
 typat 1 1          # type of atom
 xred 0.0 0.0 0.0  # reduced coordinates for primitive cell
      0.66666667  0.33333333  0.50000000

#Definition pseudopotentials
 pp_dirpath "$ABI_PSPDIR"         # repository with pseudopotentials
 pseudos "58ce.paw"   # name of pseudopotential

#Definition of the k-point grid
 kptopt 4
 ngkpt 2 2 2              # Reciprocal space vectors are built from
                          # the rprim parameters. This is the size of the
                          # reciprocal k-points.
 nshiftk 1                # Convergence of the density with regular shifts.
 shiftk 0.5  0.5  0.5

############################
# Energy Parameters
############################
 ecut 16         # Maximal plane-wave kinetic energy cut-off, in Hartree
 pawecutdg 32    # PAW: Energy Cutoff for the Double Grid
 nband 70        # Number of bands
 occopt 3        # Smearing type
 tsmear 1000 K   # Electronic smearing temperature

############################
# DFT Calculation
############################
 usedmft1 0       # DFT alone
 nstep1 30        # Number of iterations for the DFT convergence
 nline1 5         # Number of line minimizations
 nnsclo1 5        # Number of non-self consistent loop
 tolvrs1 1.0d-13  # Tolerance of the density for DFT convergence

#Definition of the spin properties
 nsppol 1     # No Spin-polarization
 nspden 4     # Non-collinear magnetism
 nspinor 2    # Spin-orbit Coupling
 spinat 0 0 0 # Magnetization vector
        0 0 0

############################
# DMFT Calculation
############################
usedmft2 1        # DMFT calculation
nstep2    1       # Number of iterations for the DFT+DMFT convergence
nline2    5      # Number of line minimisations
nnsclo2   5      # Number of non-self consistent loops
tolvrs2   1.0d-12 # Tolerance of the density for DFT convergence

#Definition for DMFT loop
dmftbandi 17            # First KS band included in the projection for Wannier orbitals
dmftbandf 68            # Last KS band included in the projection for Wannier orbitals
dmft_nwlo 501           # Logarythmic frequency mesh
dmft_nwli 1000000       # Linear frequency mesh
dmft_iter 1             # Number of iterations of the DMFT part.
                        # We often use single-shot, since anyway the charge density
                        # changes through the DFT+DMFT anyway.
dmftcheck 0
dmft_rslf 1             # Read self-energy, if nothing (like here) initialize.
dmft_mxsf 0.8           # Mixing of the old and new self-energy at every iterations.
dmft_dc   5             # Double counting type. 1 is Fully Localized Limit (FLL)
dmft_wanorthnorm 2      # Renormalization preocedure
dmft_hybri_limit 1      # Asymptotic behavior of hybridization

#Definition of impurity solver
dmft_solv         10    # CT-QMC solver in density-density approximation
dmftqmc_l        250    # Number of time slices for G(tau).
dmftqmc_n        1.d7   # Number of QMC sweeps
dmftqmc_therm   50000    # Thermalization
dmftctqmc_gmove  0      # Global move occurence in QMC
dmftctqmc_order  50     # Perturbation order

#DEfinition of DFT+U
usepawu1    4           # FLL double counting without spin-polarization
usepawu2    14          # FLL double counting in DMFT without spon-polarization
dmatpuopt   2           # The density matrix: the simplest expression.
lpawu       3           # Angular momentum for the projected Hamiltonian
upawu1      0.00 eV
upawu2      5.5  eV  # Values of U for each angular momentum
jpawu1      0.00 eV
jpawu2      0.7 eV  # Values of J

