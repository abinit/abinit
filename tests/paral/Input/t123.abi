#Multi_dataset parameters
 ndtset 2       # Two datasets
 jdtset 1 2     # one followed by two
 getden -1      # Second one takes the density of first

 pawprtvol 3  # Printing additional information
 prtvol 4     #
 prtden -1    #

############################
# Structural Parameters
############################
#Definition of unit cell
 acell 3*5.44761       # lattice parameter
 rprim -0.5  0.5  0.5  # Primitive cell
        0.5 -0.5  0.5
        0.5  0.5 -0.5

#Definition atom
 ntypat 1   # number of different types of atoms
 znucl 26   # z number of atom

#Definition of the atoms
 natom 1           # number of atom
 typat 1           # type of atom
 xred 0.0 0.0 0.0  # reduced coordinates for primitive cell

#Definition pseudopotentials
 pp_dirpath "$ABI_PSPDIR"            # repository with pseudopotentials
 pseudos "26fe.lda2.paw"

#Definition of the k-point grid
 kptopt 4
 ngkpt 4 4 4              # Reciprocal space vectors are built from
                          # the rprim parameters. This is the size of the
                          # reciprocal k-points.
 nshiftk 2                # Convergence of the density with regular shifts.
 shiftk 0.25  0.25  0.25
       -0.25 -0.25 -0.25

############################
# Energy Parameters
############################

 ecut 20         # Maximal plane-wave kinetic energy cut-off, in Hartree
 pawecutdg 40    # PAW: Energy Cutoff for the Double Grid
 nband 20        # Number of bands
 occopt 3        # Smearing type
 tsmear 3000 K   # Electronic smearing temperature

############################
# DFT Calculation
############################
 usedmft1 0       # DFT alone
 nstep1 30        # Number of iterations for the DFT convergence
 tolvrs 1.0d-15  # Tolerance of the density for DFT convergence

#Definition of the spin properties
 nsppol 2     # No spin-polarization
 nspden 2     # No Scalar magnetism
 nspinor 1    # No Spin-orbit
 spinat 0 0 0 # Magnetization vector
# spnorbscl 10 # SOC scaling

############################
# DMFT Calculation
############################
usedmft2 1        # DMFT calculation
nstep2    1       # Number of iterations for the DFT+DMFT convergence
nline2   10       # Number of line minimisations
nnsclo2  10       # Number of non-self consistent loops

#Definition for DMFT loop
dmftbandi 5             # First KS band included in the projection for Wannier orbitals
dmftbandf 13            # Last KS band included in the projection for Wannier orbitals
dmft_iter 1             # Number of iterations of the DMFT part.
                        # We often use single-shot, since anyway the charge density
                        # changes through the DFT+DMFT anyway.
dmftcheck 0
dmft_rslf 1             # Read self-energy, if nothing (like here) initialize.
dmft_mxsf 0.7           # Mixing of the old and new self-energy at every iterations.
dmft_dc   5             # Double counting type. 1 is Fully Localized Limit (FLL)
#dmftqmc_seed 2

# Wannier functions
dmft_orbital 1          # Orbital to be projected: 1 -> atomic orbital from PAW dataset / -1 -> read from file
dmft_prtwan 1           # Write projective Wannier functions
dmft_wanorthnorm 3      # Wannier orthonormalizationscheme: 3 -> Orthonormalization for all k-pointsand each atom / 2 -> Orthonormalization for each k-pointand all atoms

############################
# ABINIT Solvers
############################
#dmft_solv = 8            # CT-QMC solver in density-density approximation
#dmftqmc_l        200     # Number of time slices for G(tau).
#dmftqmc_n        1.d6    # Number of QMC sweeps
#dmftqmc_therm    10000   # Thermalization
#dmft_nwlo 500            # Logarythmic frequency mesh
#dmft_nwli 100000         # Linear frequency mesh
#
#dmftctqmc_gmove  0       # Global move occurence in QMC
#dmftctqmc_order  50      # Perturbation order
#dmftctqmc_localprop 2    # Activate Histogram and spin susceptibility
#dmft_hybri_limit 1       # Asymptotic limit of hybridization function (for dmft_solv = 10)
#
############################
# TRIQS Solvers
############################
dmft_solv 6 # Use TRIQS/CTHYB impurity solver:# 6 -> density-density# 7 -> full Slater Hamiltonian

#Grids
dmft_triqs_n_iw 5000 # Number of linear frequencies
dmft_triqs_n_tau 1000 # Number of imaginary timepoints# Interaction parameters
dmft_triqs_measure_g_l 0 # 0 -> DLR constrained fit# 1 -> CT-HYB-sampled Legendre coefficients
dmft_triqs_dlr_wmax 1.0 # Maximal real frequency forDLR
dmft_triqs_dlr_epsilon 1.0d-6 # Accuracy parameterfor DLR representation

#CTQMC
dmft_triqs_n_cycles 500 # Number of measurements perCPU.
dmft_triqs_n_warmup_cycles_init 100 # Number ofwarmup cycles at the first iteration.
dmft_triqs_n_warmup_cycles_restart 1 # Number ofwarmup cycles when restarting from previousconfiguration
dmft_triqs_length_cycle 1000 # Length of a cycle# CT-QMC basis

# Options
dmft_triqs_basis 0        # Local basis: 0 -> Cubic / 1 -> Diagonalize atomic levels / 2 -> Diagonalize occupation matrix / 3 -> Spherical harmonics / 4 -> JmJ
dmft_triqs_off_diag 0     # Neglect off-diagonal terms
dmft_triqs_chiloc 1       # Activate measurements of local spin susceptibility
dmft_triqs_chiloc_ins 1000  # Number of instance for measurements

############################
# Coulomb Interaction
############################
usepawu1    4           # Non magnetic SpinDFT
usepawu2    14          # Non magnetic SpinDFT for DMFT
dmatpuopt   2           #
lpawu       2           # Angular momentum for the projected Hamiltonian
upawu1      0.00 eV     # Average Coulomb interaction 
upawu2      5.5  eV     # Values of U for each angular momentum
jpawu1      0.00 eV
jpawu2      0.84 eV     # Values of J

