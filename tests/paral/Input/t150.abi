#ABINIT - INPUT FILE
#GOLD 31 ATOMS

# Slicing
wfoptalg 112
nslice 2
nline 12
paral_slice 0
nstep_mixed 0

# Electronic bands
nband           192
npband          4

#Plane wave basis
ecut            8.
pawecutdg       10.

#Self-consistent cycle parameters
tolwfr      1.d-6
nstep       2
nnsclo      1

# Pseudo
pp_dirpath="$ABI_PSPDIR"
pseudos="au.hpc.paw"

#K-points and symetries
nkpt 1
kpt 3*0.
kptopt 0
istwfk *1
nsym 0
chksymbreak 0

#Electronic configuration
occopt 3
tsmear 0.002 hartree

#Activation/deactivation of I/O
optforces 0
optstress 0
prtddb    0
prtwf     0
prtden    0
prteig    0
prtebands 0
#timopt    -1

#Simulation cell
acell  3*15.34
rprim 1. 0. 0. 0. 1. 0. 0. 0. 1.
natom 31
ntypat 1
typat 31*1
znucl 79.
chkprim 0

#Atomic positions
xred
              2.50000000000000e-01   2.50000000000000e-01   0.00000000000000e+00
              2.50000000000000e-01   0.00000000000000e+00   2.50000000000000e-01
