# Aluminium: band structure and disentangled Wannier functions from an IBZ WFK.

ndtset 4
kptopt 1

# Dataset 1: ground state on a symmetry-reduced uniform mesh.
tolvrs1 1.0d-10

# Dataset 2: NSCF band structure along L-Gamma-X-W-K-Gamma.
iscf2 -2
getden2 1
kptopt2 -5
ndivsm2 3
kptbounds2
  0.5   0.5   0.5
  0.0   0.0   0.0
  0.5   0.0   0.5
  0.5   0.25  0.75
  0.375 0.375 0.75
  0.0   0.0   0.0
tolwfr2 1.0d-12
nbdbuf2 4
prtebands2 1
prtwf2 0

# Dataset 3: accurately converged NSCF wavefunctions on the IBZ mesh.
iscf3 -2
getden3 1
tolwfr3 1.0d-12
nbdbuf3 4

# Dataset 4: expand dataset 3's WFK and call Wannier90.
optdriver4 8
wfk_task4 "wannier"
getwfk4 -1
w90iniprj4 2

# Common variables.
acell 3*7.60
rprim
  0.0 0.5 0.5
  0.5 0.0 0.5
  0.5 0.5 0.0
natom 1
ntypat 1
typat 1
xred 0.0 0.0 0.0
znucl 13

ecut 8.0
nband 12
nstep 50
occopt 4
tsmear 0.02
ngkpt 6 6 6
nshiftk 1
shiftk 0.0 0.0 0.0

pp_dirpath "$ABI_PSPDIR"
pseudos "Psdj_nc_sr_04_pw_std_psp8/Al.psp8"

