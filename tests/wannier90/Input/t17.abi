# GaAs: SOC band structure and Wannierization from an IBZ WFK.

ndtset 3
kptopt 1

# Dataset 1: ground state on a symmetry-reduced uniform mesh.
tolvrs1 1.0d-10

# Dataset 2: NSCF band structure along L-Gamma-X-W-K-Gamma.
iscf2 -2
getden2 1
kptopt2 -5
ndivsm2 3
kptbounds2
  0.5   0.5   0.5
  0.0   0.0   0.0
  0.5   0.0   0.5
  0.5   0.25  0.75
  0.375 0.375 0.75
  0.0   0.0   0.0
tolwfr2 1.0d-10
nbdbuf2 4
prtebands2 1
prtwf2 0

# Dataset 3: expand dataset 1's IBZ WFK internally and call wannier90.
optdriver3 8
wfk_task3 "wannier"
getwfk3 1
w90iniprj3 2

# Common variables.
acell 3*10.68
rprim
  0.0 0.5 0.5
  0.5 0.0 0.5
  0.5 0.5 0.0
natom 2
ntypat 2
typat 1 2
xred
  0.00 0.00 0.00
  0.25 0.25 0.25
znucl 31 33

# Nonmagnetic spin-orbit calculation with spinor wavefunctions.
nsppol 1
nspinor 2
nspden 1

ecut 12.0
nband 12
nstep 50
ngkpt 2 2 2
nshiftk 1
shiftk 0.0 0.0 0.0

pp_dirpath "$ABI_PSPDIR"
pseudos "Ga-low_r.psp8, As_r.psp8"

