# calculate magnetic shielding for neon atom in box
# output shielding as a density on real space mesh
# actual values contained in ORBMAG.nc object
# integrated densities in output file

kptopt 0
nkpt 1
kpt 3*0.0

nsym 1
symrel
1 0 0
0 1 0
0 0 1

istwfk *1

pawcpxocc 2
optforces 0
optstress 0
usexcnhat 0
pawxcdev 0

ndtset 2

# magnetic dipole strength 1 in x direction
natnd 1
iatnd 1
atndlist 1 0 0

nband 4
nstep 20 # set intentionally small for speed, results will not be accurately converged
ntypat 1
typat 1
znucl 10
natom 1
xred 3*1/2
acell 3*15.0

# very low ecut for speed, not converged
ecut 10.0
pawecutdg 11.0

tolvrs 1.0D-18
write_files1 "wf_1"

tolwfr2 1.0D-20
iscf2 -3
rfddk2 1
getwfk2 -1

# orbmag option 4 generates normal output + output on real space mesh
orbmag2 4
write_files2 "None"

pp_dirpath="$ABI_PSPDIR"
pseudos="Ne.GGA_PBE-JTH.xml"

