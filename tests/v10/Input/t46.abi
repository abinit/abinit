! ddb file
ddb_filepath = "t46.ddb.abo"

! output file
output_file = "t46.abo"
outdata_prefix = "t46o"

!Flags
 ifcflag   1     ! Interatomic force constant flag
 flexoflag 1
 dipquad 0
 quadquad 0 
!Wavevector grid number 1 (coarse grid, from DDB)
  brav    1      ! Bravais Lattice : 1-S.C., 2-F.C., 3-B.C., 4-Hex.)
  ngqpt   2*16 1   ! Monkhorst-Pack indices
  nqshft  1         ! number of q-points in repeated basic q-cell
  q1shft  3*0.0
  symdynmat 0
!Effective charges
  asr  6     ! Acoustic Sum Rule. 1 => imposed asymetrically
  dim_msr 4
  !rifcsph 20
!Interatomic force constant info
  dipdip 0      ! Dipole-dipole interaction treatment

!Phonon band structure output for band2eps - See note near end for
! dealing with gamma LO-TO splitting issue.
