# ABINIT - INPUT FILE
# BCC IRON 1 ATOM

# Model
natom 1
#Definition of the unit cell
acell
1.00000000000000 1.00000000000000 1.00000000000000 Angstrom
rprim
0.00000000000000 1.73917292932265 1.73917292932265
1.73917292932265 0.00000000000000 1.73917292932265
1.73917292932265 1.73917292932265 0.00000000000000
chkprim 0 # Allow non-primitive cells
#Definition of the atom types
ntypat 1
znucl 26
#Enumerate different atomic species
typat
 1
#Definition of the atoms
xcart
0.00000000000000 0.00000000000000 0.00000000000000
chkexit 1 # abinit.exit file in the running directory terminates after the current SCF

# Pseudopotentials
pp_dirpath       "$ABI_PSPDIR/Psdj_nc_fr_04_pbe_std_psp8"   # pseudopotential directory
pseudos          "Fe.psp8"                                  # pseudopotential filenames

# system
ixc              11

# Magnetism
nsppol           2            # number of spin polarizations
nspden           2            # number of spin densities
nspinor          1
spinat
0 0 4.0                       # initial spin moments (x y z per atom)

# Planewave basis
ecut             10

# k-point grid
ngkpt            2 2 2
chksymbreak      0            # do not check for symmetry breaking

# Diagonalization
wfoptalg         114          # wavefunction optimization algorithm
nline            8
nblock_lobpcg    1

fftalg           401

# Occupations
occopt           3            # smearing option
tsmear           0.005        # smearing temperature [Ha]
nband            16           # number of bands

# SCF
nstep            20           # maximum SCF iterations
iscf             17           # Pulay mixing on density
npulayit         10           # history size for Pulay mixing
diemix           0.8          # density mixing factor
tolvrs           1e-10        # SCF convergence tolerance on density

# SCF Preconditioning
iprcel           202
precon_ls_maxite 20           # max iterations for preconditioner linear solver
precon_ls_rtol   0.000001     # relative tolerance for preconditioner linear solver
precon_tsmear    0.01

# Output control
prtwf            0            # do not print wavefunctions
prtden           0            # do not print density
prteig           0            # do not print eigenvalues

