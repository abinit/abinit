!{\src2tex{textfont=tt}}
!!****f* ABINIT/xmpi_max_int0d_i4b
!! NAME
!!  xmpi_max_int0d_i4b
!!
!! FUNCTION
!!  This module contains functions that calls MPI routine,
!!  if we compile the code using the MPI  CPP flags.
!!  xmpi_max is the generic function.
!!
!! COPYRIGHT
!!  Copyright (C) 2001-2026 ABINIT group (AR,XG,MB)
!!  This file is distributed under the terms of the
!!  GNU General Public License, see ~ABINIT/COPYING
!!  or http://www.gnu.org/copyleft/gpl.txt .
!!
!! SOURCE

subroutine xmpi_max_int0d_i4b(xval,xmax,comm,ierr)

!Arguments-------------------------
 integer ,intent(in) :: xval
 integer, intent(out) :: xmax
 integer ,intent(in) :: comm
 integer ,intent(out) :: ierr

!Local variables-------------------
#if defined HAVE_MPI
 integer :: arr_xmax(1),arr_xval(1)
#endif
! *************************************************************************

 ierr=0
#if defined HAVE_MPI
 if (comm /= MPI_COMM_SELF .and. comm /= MPI_COMM_NULL) then
   arr_xval(1) = xval
   call MPI_ALLREDUCE(arr_xval,arr_xmax,1,MPI_INTEGER,MPI_MAX,comm,ierr)
   xmax=arr_xmax(1)
 else
#endif
   xmax=xval
#if defined HAVE_MPI
 end if
#endif

end subroutine xmpi_max_int0d_i4b
!!***


