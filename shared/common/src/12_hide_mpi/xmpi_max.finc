!!****f* ABINIT/xmpi_max_dp1d_ip
!! NAME
!!  xmpi_max_dp1d_ip
!!
!! SOURCE

subroutine xmpi_max_dp1d_ip(xval, comm, ierr)

!Arguments-------------------------
 real(dp),intent(inout) :: xval(:)
 integer ,intent(in) :: comm
 integer ,intent(out) :: ierr

!Local variables-------------------
#if defined HAVE_MPI
 real(dp) :: arr_xval(size(xval))
#endif
! *************************************************************************

 ierr=0
#if defined HAVE_MPI
 if (comm /= MPI_COMM_SELF .and. comm /= MPI_COMM_NULL) then
   arr_xval = xval
   call MPI_ALLREDUCE(arr_xval,xval,size(xval),MPI_DOUBLE_PRECISION,MPI_MAX,comm,ierr)
 end if
#endif

end subroutine xmpi_max_dp1d_ip
